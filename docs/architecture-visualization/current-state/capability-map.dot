digraph business_capability_map {
    graph [
        rankdir=TB,
        splines=true,
        overlap=false,
        nodesep=0.5,
        ranksep=0.6,
        bgcolor="#FFFFFF",
        fontname="Microsoft YaHei",
        fontsize=12,
        labelloc=t,
        label="业务能力地图（当前态）\n快照 2026-10-23 @ e07669d7 · 证据：README / AGENTS.md / baseline §1.2 / docs/version"
    ];
    node [
        shape=box,
        style="rounded,filled",
        fontname="Microsoft YaHei",
        fontsize=10,
        color="#94A3B8",
        fillcolor="#FFFFFF",
        penwidth=1.1
    ];
    edge [
        fontname="Microsoft YaHei",
        fontsize=8,
        color="#475569",
        arrowsize=0.7
    ];

    subgraph cluster_value {
        label="用户价值（为什么用）";
        style="rounded,dashed";
        color="#99F6E4";
        fontcolor="#115E59";
        vRemember [label="被记得\n跨会话、跨通道", fillcolor="#CCFBF1"];
        vCompanion [label="被陪伴\n有情绪、有关系、有人格", fillcolor="#CCFBF1"];
        vProactive [label="被主动关心\n不是只有提问才回应", fillcolor="#CCFBF1"];
        vLife [label="生活事务可管理\n账本 / 车辆 / 任务 / 简报", fillcolor="#CCFBF1"];
    }

    subgraph cluster_product {
        label="产品能力（已实现）";
        style="rounded,dashed";
        color="#BAE6FD";
        fontcolor="#075985";
        cChat [label="对话与角色扮演\n流式回答 · 场景连续性 · 行为策略", fillcolor="#E0F2FE"];
        cRelation [label="情绪与关系\n8 值情绪 · 六维关系 · 冲突 / 里程碑", fillcolor="#E0F2FE"];
        cMemory [label="长期记忆与成长\n7 类型 · 生命周期 · 检索 · 反思", fillcolor="#E0F2FE"];
        cGoal [label="目标与规划\n目标栈 · 计划 · 决策 · 审批", fillcolor="#E0F2FE"];
        cAction [label="行动与工具\n提醒 · 搜索 · 外部 API · 确认", fillcolor="#E0F2FE"];
        cWorld [label="世界模拟\n时间 · 地点 · 物品 · 日计划", fillcolor="#E0F2FE"];
        cLife [label="生活域\n账本 · 车辆 · 任务 · 简报", fillcolor="#E0F2FE"];
    }

    subgraph cluster_support {
        label="支撑能力";
        style="rounded,dashed";
        color="#CBD5E1";
        fontcolor="#334155";
        sIdentity [label="身份与多通道\n邮箱验证码 · 飞书 OAuth · 账号绑定", fillcolor="#F1F5F9"];
        sRuntime [label="Agent Runtime\nRun 台账 · Profile · Trigger · Gateway", fillcolor="#F1F5F9"];
        sEval [label="评估与可观测\ntrace · decision · 离线 / 在线评估", fillcolor="#F1F5F9"];
        sRelease [label="发布与更新\n制品入库 · 版本检查 · 断点续传", fillcolor="#F1F5F9"];
        sData [label="数据与治理\nAlembic · 仓储 · 导出 / 删除", fillcolor="#F1F5F9"];
    }

    cChat -> vCompanion [label="创造陪伴感"];
    cRelation -> vCompanion [label="关系会变化"];
    cRelation -> vRemember [label="关系事实"];
    cMemory -> vRemember [label="核心承诺"];
    cMemory -> vProactive [label="记忆驱动主动行为"];
    cGoal -> vProactive [label="自主目标 / 计划"];
    cAction -> vProactive [label="提醒 / 主动消息"];
    cWorld -> vCompanion [label="角色的生活世界"];
    cWorld -> vProactive [label="世界事件触发"];
    cLife -> vLife [label="可执行的生活事务"];

    sIdentity -> cChat [label="所有通道收敛", style=dashed];
    sIdentity -> cLife [label="用户归属", style=dashed];
    sRuntime -> cChat [label="唯一循环", style=dashed];
    sRuntime -> cGoal [label="Run 驱动", style=dashed];
    sEval -> cChat [label="质量回归", style=dashed];
    sEval -> cMemory [label="离线指标", style=dashed];
    sRelease -> cLife [label="客户端可达", style=dashed];
    sData -> cMemory [label="持久化 / 治理", style=dashed];
    sData -> cLife [label="持久化 / 治理", style=dashed];

    note [
        shape=note,
        label="此图是产品能力归纳，不是运行链路。\n详细角色/服务/表名见 C4 与数据域图。",
        fillcolor="#FFFBEB",
        color="#D97706",
        fontcolor="#92400E",
        fontsize=8
    ];
}
