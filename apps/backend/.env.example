# LLM Profiles：二选一（LLM_PROFILES_JSON 优先级更高，同配置时忽略文件）
#   方式 A（推荐，可排版）：LLM_PROFILES_FILE 指向独立 JSON 文件，格式任意缩进
#   方式 B（单行内联）：LLM_PROFILES_JSON=<JSON 数组>，必须写在同一物理行
# REQUIRED fields: id, label, base_url, model, api_key
# OPTIONAL fields: max_tokens, temperature, top_p, frequency_penalty, presence_penalty, extra_body_thinking
# OPTIONAL `extra_body`（对象）：原样透传进请求体顶层，设置后将取代默认的 thinking 注入
#   例：OpenRouter 开启推理 —— "extra_body": { "reasoning": { "enabled": true } }
#
LLM_PROFILES_FILE=llm_profiles.json
DEFAULT_LLM_PROFILE=minimax-m3

# 最终回答的 max_tokens 上限（仅作用于回答链；辅助链如路由/状态/记忆使用各 profile 的 max_tokens）
ANSWER_MAX_TOKENS=60
TEMPERATURE=0.9
TOP_P=0.92
FREQUENCY_PENALTY=0.4
PRESENCE_PENALTY=0.5

# Database
DATABASE_URL=postgresql+psycopg://asuna:asuna@127.0.0.1:5432/asuna?connect_timeout=5
# 语句超时（毫秒，0=关闭；启用后超时 SQL 主动失败，避免慢查询拖死连接池）
# DB_STATEMENT_TIMEOUT_MS=30000

# Conversation
CONVERSATION_MAX_MESSAGES=20
CONVERSATION_MAX_CHARS=8000

# Summary
SUMMARY_THRESHOLD=40

# Memory
MEMORY_IMPORTANCE_THRESHOLD=0.6
MEMORY_TOP_K=5

# 演绎段注入策略位：full = 注入人设/情绪/关系/世界/场景/行为/风格段；
# off = 只保留功能上下文（记忆/认知/目标/行动/历史），世界与角色引擎照常运行，仅停止注入
ROLEPLAY_PROMPT_MODE=full

# Character Action Sync：调参（开关已固化常开，无配置面）
# 注入 prompt「最近世界变化」段的条数；<=0 表示不注入该段
CHARACTER_ACTION_SYNC_CONTEXT_LINES=3

# Inventory grounding guard：回复库存陈述与账本对账（开关已固化常开）
# 取值 off / rewrite / annotate —— off 是唯一的关断位；rewrite 冲突时改写回复；annotate 只记 trace
INVENTORY_GROUNDING_MODE=rewrite

# World Simulation：调参（开关已固化常开，无配置面）
# 模拟参数
WORLD_SIM_INTERVAL_SECONDS=60
SIM_ADVANCE_MAX_MINUTES=120
WORLD_EVENT_TICK_CAP=8
CATCH_UP_MAX_DAYS=7
WORLD_BRIEF_CHAR_BUDGET=400
WORLD_PROMPT_CHAR_BUDGET=1000
# 历史计划保留期（天）：每日跨天时裁剪；<=0 表示不裁剪
DAILY_PLAN_RETENTION_DAYS=30
USER_SITUATION_VALID_HOURS=48
WORLD_LLM_ASSIST_SAMPLE_RATE=0.2
WORLD_EVENT_ESCALATION_TYPES=user_condition,weather_change,calendar_event,goal_completed
INTEREST_CONFIDENCE_THRESHOLD=0.7

# ===== V2.4.0 Tool System（工具系统已转正常开，仅余治理参数与策略位）=====
# 运行期禁用清单（逗号分隔的 tool_id）
TOOL_DISABLED_IDS=
TOOL_SURFACE_MAX_TOOLS=12
TOOL_BREAKER_THRESHOLD=3
TOOL_BREAKER_COOLDOWN_SECONDS=300
TOOL_CONFIRM_TIMEOUT_HOURS=24
# 策略位：true = 批准落 TTL 持久授权（跨轮复用）；false = 批准只放行当次
TOOL_CONFIRM_TTL_REUSE=true
TOOL_AUDIT_RETENTION_DAYS=180

# 外部 API 清单目录（空 = 不加载任何清单；示例目录见 app/services/tool/manifests/）
TOOL_EXT_MANIFEST_PATH=
# 外部 API 域名白名单（逗号分隔；空 = 全禁，硬纪律）
TOOL_EXT_ALLOWED_HOSTS=
# 凭据只从环境变量读取，声明文件里只写变量名（占位示例，不要在这里填真实值）
# EXT_API_WEATHER_TOKEN=
# EXT_API_HOOK_KEY=

# 简报天气源（Open-Meteo，免 key；坐标不配 = 天气卡降级为占位，可被偏好城市 / 请求坐标覆盖）
# WEATHER_LATITUDE=39.9042
# WEATHER_LONGITUDE=116.4074
# WEATHER_CACHE_TTL_SECONDS=1800

# Feishu Channel Adapter（默认关闭；启用时 APP_ID / APP_SECRET / VERIFICATION_TOKEN 必填）
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# FEISHU_DEDUPE_PERSISTENT_ENABLED=false
# FEISHU_INSTANCE_INDEX=0
# FEISHU_INGRESS_SHARDED_ROUTING_ENABLED=false
# FEISHU_ROUTER_ENABLED=false
# FEISHU_ROUTER_INSTANCE_URLS=
# FEISHU_ROUTER_TIMEOUT_SECONDS=5.0
# FEISHU_API_BASE=https://open.feishu.cn
# FEISHU_LLM_PROFILE=
# FEISHU_TIMEOUT_SECONDS=10.0
# FEISHU_TOKEN_REFRESH_RATIO=0.8
# FEISHU_MAX_REPLY_CHARS=4000
# FEISHU_DEDUPE_TTL_SECONDS=600
# FEISHU_SIGNATURE_WINDOW_SECONDS=300
# FEISHU_MAX_CONCURRENT_TURNS=4
# FEISHU_SESSION_QUEUE_LIMIT=5
# FEISHU_MAX_BODY_BYTES=262144
# FEISHU_MERGE_WINDOW_MS=800
# FEISHU_MERGE_MAX_MESSAGES=10
# FEISHU_MERGE_MAX_CHARS=20000
# FEISHU_RATE_LIMIT_PER_MINUTE=0
# FEISHU_OUTBOUND_IDEMPOTENCY_TTL_SECONDS=0
# FEISHU_INSTANCE_COUNT=1
# FEISHU_HTTP_MAX_ATTEMPTS=3
# FEISHU_HTTP_BACKOFF_SECONDS=0.5
# FEISHU_HTTP_BACKOFF_MAX_SECONDS=8.0

# ===== Action Execution System =====
ACTION_SCHEDULE_DEFAULT_PRIORITY=100
# 孤儿 executing 超时恢复阈值（分钟）
ACTION_EXECUTING_TIMEOUT_MINUTES=30

# Auth（邮箱验证码登录签发无状态令牌；设备配对链路已退役）
AUTH_TOKEN_SECRET=
BRIEFING_MORNING_TIME=08:00
BRIEFING_EVENING_TIME=21:30

# Redis（邮箱验证码登录依赖；未配置时该端点返回 503）
REDIS_URL=redis://127.0.0.1:6379/0

# Email 验证码登录（EMAIL_SMTP_HOST 配置后 USER / PASSWORD / FROM_ADDRESS 必填）
# 163 个人邮箱：smtp.163.com:465 SSL；PASSWORD 填「授权码」（邮箱设置开启 SMTP 后生成），不是登录密码
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SSL=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=朝夕
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_SEND_HOURLY_CAP=6
EMAIL_CODE_SEND_DAILY_CAP=20
EMAIL_CODE_MAX_ATTEMPTS=5

# Car（车辆域提醒提前量；投递复用端侧本地通知，服务端只给派生提醒）
CAR_SERVICE_REMIND_KM_BEFORE=3000
CAR_SERVICE_REMIND_DAYS_BEFORE=45
CAR_INSURANCE_REMIND_DAYS_BEFORE=60
CAR_INSPECTION_REMIND_DAYS_BEFORE=30

# IDs（雪花 ID 发号；ADR-16。epoch 有数据后不可改；多实例 MACHINE_ID 须互异且互斥，
# 分配约定：0=默认应用实例，1023=迁移回填专用保留，1~1022=扩容可用）
IDS_EPOCH_DATE=2026-01-01
IDS_MACHINE_ID=0
IDS_HIGH_WATER_KEY=ids:high_water_ms
IDS_HIGH_WATER_FLUSH_SECONDS=5
IDS_CLOCK_ROLLBACK_TOLERANCE_MS=0

# Debug（调试台面门禁；生产部署必须设 true，/debug/*、/state、action、world 统一 404）
DEBUG_SURFACE_ENFORCED=false
