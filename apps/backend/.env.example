# LLM Profiles：二选一（LLM_PROFILES_JSON 优先级更高，同配置时忽略文件）
#   方式 A（推荐，可排版）：LLM_PROFILES_FILE 指向独立 JSON 文件，格式任意缩进
#   方式 B（单行内联）：LLM_PROFILES_JSON=<JSON 数组>，必须写在同一物理行
# REQUIRED fields: id, label, base_url, model, api_key
# OPTIONAL fields: max_tokens, temperature, top_p, frequency_penalty, presence_penalty, extra_body_thinking
# OPTIONAL `extra_body`（对象）：原样透传进请求体顶层，设置后将取代默认的 thinking 注入
#   例：OpenRouter 开启推理 —— "extra_body": { "reasoning": { "enabled": true } }
#
LLM_PROFILES_FILE=llm_profiles.json
DEFAULT_LLM_PROFILE=minimax-m3

# 最终回答的 max_tokens 上限（仅作用于回答链；辅助链如路由/状态/记忆使用各 profile 的 max_tokens）
ANSWER_MAX_TOKENS=60
TEMPERATURE=0.9
TOP_P=0.92
FREQUENCY_PENALTY=0.4
PRESENCE_PENALTY=0.5

# Database
DATABASE_URL=postgresql+psycopg://asuna:asuna@localhost:5432/asuna

# Conversation
CONVERSATION_MAX_MESSAGES=20
CONVERSATION_MAX_CHARS=8000

# Summary
SUMMARY_THRESHOLD=40

# Memory
MEMORY_IMPORTANCE_THRESHOLD=0.6
MEMORY_TOP_K=5

# Character Action Sync (V2): extract CREATE/MOVE/CONSUME from character replies
V2_CHARACTER_ACTION_SYNC_ENABLED=true
V2_CHARACTER_ACTION_SYNC_CONTEXT_LINES=3

# Inventory grounding guard: reconcile reply stock claims with world ledger
V2_INVENTORY_GROUNDING_ENABLED=true
V2_INVENTORY_GROUNDING_MODE=rewrite

# World Simulation (V2.3.0)：总闸 + 子闸双开才生效；全部默认 off
# 开启顺序：总闸 → time_advance → daily_life → event_detection → scene/habit → llm_assist
V23_WORLD_SIMULATION_ENABLED=false
V23_TIME_ADVANCE_ENABLED=false
V23_DAILY_LIFE_ENABLED=false
V23_EVENT_DETECTION_ENABLED=false
V23_SCENE_EXPANSION_ENABLED=false
V23_HABIT_TIME_ENABLED=false
V23_WORLD_LLM_ASSIST_ENABLED=false
# 调试用：允许 POST /debug/world/simulation/tick 手动跑一次维护步（仅测试环境开）
V23_DEBUG_TICK_ENABLED=false
# 模拟参数
WORLD_SIM_INTERVAL_SECONDS=60
SIM_ADVANCE_MAX_MINUTES=120
WORLD_EVENT_TICK_CAP=8
CATCH_UP_MAX_DAYS=7
WORLD_BRIEF_CHAR_BUDGET=400
WORLD_CONTEXT_CHAR_BUDGET_V23=1000
DAILY_PLAN_RETENTION_DAYS=30
USER_SITUATION_VALID_HOURS=48
V23_LLM_ASSIST_SAMPLE_RATE=0.2
V23_EVENT_ESCALATION_TYPES=user_condition,weather_change,calendar_event,goal_completed
V23_INTEREST_CONFIDENCE_THRESHOLD=0.7

# Feishu Channel Adapter（默认关闭；启用时 APP_ID / APP_SECRET / VERIFICATION_TOKEN 必填）FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# FEISHU_API_BASE=https://open.feishu.cn
# FEISHU_LLM_PROFILE=
# FEISHU_TIMEOUT_SECONDS=10.0
# FEISHU_TOKEN_REFRESH_RATIO=0.8
# FEISHU_MAX_REPLY_CHARS=4000
# FEISHU_DEDUPE_TTL_SECONDS=600
# FEISHU_SIGNATURE_WINDOW_SECONDS=300
# FEISHU_MAX_CONCURRENT_TURNS=4
# FEISHU_SESSION_QUEUE_LIMIT=5
# FEISHU_HTTP_MAX_ATTEMPTS=3
# FEISHU_HTTP_BACKOFF_SECONDS=0.5
# FEISHU_HTTP_BACKOFF_MAX_SECONDS=8.0