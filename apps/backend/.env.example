# LLM Profiles (JSON array). Each profile is an OpenAI-compatible endpoint.
# REQUIRED fields: id, label, base_url, model, api_key
# OPTIONAL fields: max_tokens, temperature, top_p, frequency_penalty, presence_penalty, extra_body_thinking
# OPTIONAL `extra_body`（对象）：原样透传进请求体顶层，设置后将取代默认的 thinking 注入
#   例：OpenRouter 开启推理 —— "extra_body": { "reasoning": { "enabled": true } }
#
LLM_PROFILES_JSON='[
  {
    "id": "longcat",
    "label": "LongCat (longcat.chat)",
    "base_url": "https://api.longcat.chat/openai/v1",
    "model": "LongCat-2.0",
    "api_key": "REPLACE_WITH_LONGCAT_KEY",
    "max_tokens": 50
  },
  {
    "id": "minimax-m3",
    "label": "MiniMax M3 (gmi-serving)",
    "base_url": "https://api.gmi-serving.com/v1",
    "model": "MiniMaxAI/MiniMax-M3",
    "api_key": "REPLACE_WITH_MINIMAX_KEY",
    "max_tokens": 1024
  },
  {
    "id": "openrouter-glm",
    "label": "GLM 5.2 (OpenRouter free)",
    "base_url": "https://openrouter.ai/api/v1",
    "model": "z-ai/glm-5.2:free",
    "api_key": "REPLACE_WITH_OPENROUTER_KEY",
    "max_tokens": 1024,
    "extra_body": { "reasoning": { "enabled": true } }
  },
  {
    "id": "qwen3.7-plus-2026-05-26",
    "label": "qwen3.7-plus-2026-05-26",
    "base_url": "https://llm-y8rsj9qfa4h202ar.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
    "model": "qwen3.7-plus-2026-05-26",
    "api_key": "REPLACE_WITH_OPENROUTER_KEY",
    "max_tokens": 50
  }
]'
DEFAULT_LLM_PROFILE=minimax-m3

# 最终回答的 max_tokens 上限（仅作用于回答链；辅助链如路由/状态/记忆使用各 profile 的 max_tokens）
ANSWER_MAX_TOKENS=60
TEMPERATURE=0.9
TOP_P=0.92
FREQUENCY_PENALTY=0.4
PRESENCE_PENALTY=0.5

# Database
DATABASE_URL=postgresql+psycopg://asuna:asuna@localhost:5432/asuna

# Conversation
CONVERSATION_MAX_MESSAGES=20
CONVERSATION_MAX_CHARS=8000

# Summary
SUMMARY_THRESHOLD=40

# Memory
MEMORY_IMPORTANCE_THRESHOLD=0.6
MEMORY_TOP_K=5