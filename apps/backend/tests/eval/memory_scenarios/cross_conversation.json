{
  "kind": "cross_conversation",
  "scenarios": [
    {
      "id": "cc-01",
      "description": "同内容跨会话重复注入只保留一条记忆",
      "steps": [
        {
          "action": "seed",
          "ref": "first",
          "content": "用户在杭州西湖附近上班",
          "type": "user_fact",
          "source": "user_stated",
          "salience": 0.8,
          "source_id": "conv:a:1"
        },
        {
          "action": "seed",
          "ref": "second",
          "content": "用户在杭州西湖附近上班",
          "type": "user_fact",
          "source": "user_stated",
          "salience": 0.8,
          "source_id": "conv:b:1",
          "expect": {
            "approved": false,
            "reason": "duplicate_exact"
          }
        },
        {
          "action": "count_check",
          "expect_active_memories": 1
        }
      ]
    },
