      "id": "pr-01",
      "description": "同义改述查询（语义通道）命中原记忆",
      "steps": [
        {
          "action": "seed",
          "ref": "watermelon",
          "content": "用户喜欢吃西瓜",
          "type": "user_preference",
          "source": "user_stated",
          "salience": 0.8
