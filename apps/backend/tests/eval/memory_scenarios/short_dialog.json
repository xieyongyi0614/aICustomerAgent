{
  "kind": "short_dialog",
  "scenarios": [
    {
      "id": "sd-01",
      "description": "基本事实注入后按查询召回",
      "steps": [
        {"action": "seed", "ref": "fruit", "content": "用户最喜欢的水果是西瓜", "type": "user_preference", "source": "user_stated", "salience": 0.8},
        {"action": "seed", "ref": "job", "content": "用户在深圳做程序员", "type": "user_fact", "source": "user_stated", "salience": 0.8},
        {"action": "probe", "query": "用户最喜欢什么水果", "top_k": 1, "expect_top": "fruit"}
      ]
    },
    {
      "id": "sd-02",
      "description": "宠物事实注入后召回且不含无关记忆",
      "steps": [
        {"action": "seed", "ref": "cat", "content": "用户养了一只叫团子的猫", "type": "user_fact", "source": "user_stated", "salience": 0.8},
        {"action": "seed", "ref": "hobby", "content": "用户周末喜欢爬山", "type": "user_preference", "source": "user_stated", "salience": 0.8},
        {"action": "probe", "query": "用户养的宠物是什么", "top_k": 1, "expect_top": "cat", "expect_not_ids": ["hobby"]}
      ]
    }
  ]
}
