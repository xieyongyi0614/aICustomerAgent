        {"action": "seed", "ref": "guess", "content": "用户可能喜欢爬山", "type": "user_preference", "source": "ai_inferred", "salience": 0.8, "expect": {"approved": true, "confidence_max": 0.4}},
        {"action": "count_check", "expect_active_memories": 1}
