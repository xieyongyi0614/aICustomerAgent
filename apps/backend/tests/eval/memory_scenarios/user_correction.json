{
  "kind": "user_correction",
  "scenarios": [
    {
      "id": "uc-01",
      "description": "用户改口（吃辣→不吃辣）→ 旧记忆 superseded 且链可溯",
      "steps": [
        {
          "action": "seed",
          "ref": "old",
          "content": "用户喜欢吃辣",
          "type": "user_preference",
          "source": "user_stated",
          "salience": 0.8
        },
        {
          "action": "seed",
          "ref": "new",
          "content": "用户不吃辣",
          "type": "user_preference",
          "source": "user_stated",
          "salience": 0.8
        },
        {
          "action": "supersede_check",
          "new_ref": "new",
          "superseded_refs": [
            "old"
          ],
          "relation": "supersedes"
        }
      ]
    },
    {
