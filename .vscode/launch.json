{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI 后端 (uvicorn, 热重载)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "python": "${workspaceFolder}/apps/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/apps/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/backend"
      },
      "justMyCode": true
    },
    {
      "name": "FastAPI 后端 (pytest 调试)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-x"],
      "python": "${workspaceFolder}/apps/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/apps/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/backend"
      },
      "justMyCode": true
    }
  ]
}
